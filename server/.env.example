OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
# Set only when relaying to a non-OpenAI provider (Gemini, Groq, ...) whose
# model names differ from what the desktop app requests ("gpt-4o-mini").
# Example for Gemini's free tier: OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#                                  OPENAI_MODEL_OVERRIDE=gemini-2.0-flash
OPENAI_MODEL_OVERRIDE=
SUPABASE_URL=
SUPABASE_JWT_SECRET=
# Per-authenticated-user request limit on /v1/chat/completions (sliding
# 60s window). 0 disables the limit. Default protects against a single
# account burning the whole server's upstream API quota/cost.
CHAT_RATE_LIMIT_PER_MINUTE=20
# Reject request bodies larger than this many bytes with 413.
CHAT_MAX_BODY_BYTES=300000
# Ceiling injected/clamped onto every request's max_tokens - the desktop
# client never sends this field, so without a server-side ceiling upstream
# completion length (and cost) is unbounded.
CHAT_MAX_COMPLETION_TOKENS=1024
# Per-authenticated-user request count over a rolling 24h window. 0 disables.
# Independent of CHAT_RATE_LIMIT_PER_MINUTE, which alone still allows a
# near-unlimited number of requests spread across a day.
CHAT_DAILY_LIMIT_PER_USER=300
# Per-authenticated-user cumulative prompt+completion token count over a
# rolling 24h window, read from each response's usage.total_tokens. This is
# the actual cost-based cap - CHAT_DAILY_LIMIT_PER_USER alone bounds request
# *count*, not the size of each request's prompt. 0 disables.
CHAT_DAILY_TOKEN_LIMIT_PER_USER=200000
