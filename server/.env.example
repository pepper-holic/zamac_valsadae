OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
# Set only when relaying to a non-OpenAI provider (Gemini, Groq, ...) whose
# model names differ from what the desktop app requests ("gpt-4o-mini").
# Example for Gemini's free tier: OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#                                  OPENAI_MODEL_OVERRIDE=gemini-2.0-flash
OPENAI_MODEL_OVERRIDE=
SUPABASE_URL=
SUPABASE_JWT_SECRET=
# Per-authenticated-user request limit on /v1/chat/completions (sliding
# 60s window). 0 disables the limit. Default protects against a single
# account burning the whole server's upstream API quota/cost.
CHAT_RATE_LIMIT_PER_MINUTE=20
# Reject request bodies larger than this many bytes with 413.
CHAT_MAX_BODY_BYTES=300000
